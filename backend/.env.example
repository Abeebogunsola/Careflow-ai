# ==============================================================================
# CareFlow AI — Backend Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Copy this file to '.env' before running the application locally.
# - Never commit real credentials, passwords, or production keys to version control.
# - For production deployments, override these values with secure environment variables.
# ==============================================================================

# Application Metadata
PROJECT_NAME="CareFlow AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security Configuration
# CRITICAL: In production, generate a strong random secret key (e.g., openssl rand -hex 32)
SECRET_KEY="insecure-dev-secret-key-change-in-production"

# CORS Configuration
# Comma-separated list of allowed origins.
# Wildcard '*' is strictly forbidden in production per docs/safety-privacy.md.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/careflow_db"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=False

# AI Agent Configuration (Phase 7)
# Provider options: "mock" (default, zero-cost, offline testing), "openai", "groq", "custom"
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="llama-3.3-70b-versatile"
LLM_BASE_URL=""
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=15

# n8n Workflow Automation Engine (Phase 8)
N8N_PORT=5678
N8N_HOST="localhost"
N8N_WEBHOOK_URL="http://localhost:5678/"
REMINDER_WINDOW_HOURS=24
MISSED_APPOINTMENT_GRACE_MINUTES=60


