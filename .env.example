# ==============================================================================
# CareFlow AI — Root Environment Configuration Template
# ==============================================================================
# Copy to '.env' for local Docker Compose and backend execution.
# Never commit real production credentials or patient data.
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careflow_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/careflow_db

# Backend Service
PROJECT_NAME="CareFlow AI"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=insecure-dev-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# AI Agent Configuration (Phase 7)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=15

# n8n Automation Engine Configuration (Phase 8)
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
REMINDER_WINDOW_HOURS=24
MISSED_APPOINTMENT_GRACE_MINUTES=60


