# =============================================================================
# CareFlow AI — Production Environment Variables Template
#
# Copy this file to '.env' on your production server:
#   cp .env.production.example .env
#
# CRITICAL SECURITY RULES:
# 1. Never commit your actual '.env' file with real credentials to version control.
# 2. Generate strong cryptographic keys using OpenSSL as documented below.
# 3. Restrict file permissions on the production server: chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment & Application Mode
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False

# -----------------------------------------------------------------------------
# 2. Cryptographic Secrets
# Generate using: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string
N8N_ENCRYPTION_KEY=replace-with-a-secure-random-64-character-hex-string

# -----------------------------------------------------------------------------
# 3. PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_USER=careflow_admin
# Generate password using: openssl rand -base64 24
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=careflow_prod
POSTGRES_PORT=5432

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# 4. Ingress, Domains & CORS Configuration
# Set to your production domains (comma-separated, NO WILDCARD '*' IN PRODUCTION)
# -----------------------------------------------------------------------------
DOMAIN_NAME=careflow.example.com
CORS_ORIGINS=https://careflow.example.com,https://app.careflow.example.com

# -----------------------------------------------------------------------------
# 5. AI Agent & LLM Configuration
# Default is 'mock' (100% offline, zero operational cost, fully deterministic).
# To activate a live cloud LLM, change LLM_PROVIDER to 'groq' or 'openai'.
# -----------------------------------------------------------------------------
LLM_PROVIDER=mock
# Optional: Set when LLM_PROVIDER is 'groq' or 'openai'
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=

# -----------------------------------------------------------------------------
# 6. External Messaging Integrations (Optional)
# Leave blank to use simulated webhook mode (zero external fees).
# Populate when connecting live SMS / WhatsApp outreach via Twilio.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# 7. n8n Automation Engine Settings
# -----------------------------------------------------------------------------
N8N_HOST=careflow.example.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://careflow.example.com/webhook/
